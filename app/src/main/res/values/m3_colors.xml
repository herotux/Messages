<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Homa Material 3 semantic color layer.
        Base roles are independent of legacy aliases so legacy consumers can
        safely be bridged to these semantic roles without resource cycles.
        API 31+ dynamic overrides live in values-v31/m3_colors.xml.
    -->
    <color name="m3_primary">@color/md_green_900</color>
    <color name="m3_on_primary">@color/md_grey_white</color>
    <color name="m3_primary_container">@color/md_green_700</color>
    <color name="m3_on_primary_container">@color/md_grey_white</color>

    <color name="m3_secondary">@color/md_teal_500</color>
    <color name="m3_on_secondary">@color/md_grey_white</color>
    <color name="m3_secondary_container">@color/md_teal_500</color>
    <color name="m3_on_secondary_container">@color/md_grey_white</color>

    <color name="m3_tertiary">@color/md_blue_500</color>
    <color name="m3_on_tertiary">@color/md_grey_white</color>
    <color name="m3_tertiary_container">@color/md_blue_500</color>
    <color name="m3_on_tertiary_container">@color/md_grey_white</color>

    <color name="m3_background">@color/md_grey_white</color>
    <color name="m3_on_background">@color/md_grey_800_dark</color>
    <color name="m3_surface">@color/md_grey_white</color>
    <color name="m3_on_surface">@color/md_grey_800_dark</color>
    <color name="m3_surface_variant">@color/md_grey_300</color>
    <color name="m3_on_surface_variant">@color/md_grey_700</color>

    <color name="m3_outline">@color/md_grey_500</color>
    <color name="m3_error">@color/md_red_700</color>
    <color name="m3_on_error">@color/md_grey_white</color>

    <color name="m3_status_bar">@color/md_green_900</color>
    <color name="m3_navigation_bar">@color/md_grey_white</color>
    <color name="m3_ripple">@color/activated_item_foreground</color>
</resources>
